---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="home-page">
    <div class="home-header">
      <h1>Welcome to Bible Baptist Church - Paris</h1>
      <p>We would love to have you worship with us.</p>
    </div>

    <div class="home-content">
      <section class="info-section">
        <h2>Our Services</h2>

        <div class="service">
          <h3>Sunday School</h3>
          <p>1:00 PM</p>
        </div>

        <div class="service">
          <h3>Sunday Service</h3>
          <p>2:00 PM</p>
        </div>

        <div class="service">
          <h3>Friday Bible Study</h3>
          <p>9:00 PM (Online)</p>
        </div>
      </section>

      <section class="info-section">
        <h2>Our Location</h2>

        <p>Bible Baptist Church - Paris</p>

        <p>13 Rue des Fontaines du Temple, 75003 Paris</p>

        <a
          href="https://l.facebook.com/l.php?u=https%3A%2F%2Fmaps.app.goo.gl%2Fd7on3jS7jQLSFYaH6%3Ffbclid%3DIwZXh0bgNhZW0CMTAAcGRvZgVicmlkETFXaWJacTRhOHdtWGFDak16c3J0YwZhcHBfaWQQMjIyMDM5MTc4ODIwMDg5MgABHgIwLKaOB6TKx-FbkAwQWjkl8twqBya1sySIhI-LHlpdntqQoqYG1jWeT-a1_aem_nJVDh3bsGVva24B1pg9XfQ&h=AUBM9RcpNkHyxd7yzKStMJMnEe9e6c8D7yA9VbN-wTXSR5pg5HbZEzxB2dQOv3-JubT1zMyWSEdu7EO2y_9vdeED2c4PU2-lAEwGhLkTIcNfj5lf8qA1E8da_MEtUK6gfkBM4AboOtz3fkHAF5MrC7dV"
          target="_blank"
          rel="noopener noreferrer"
          class="map-btn"
        >
          View on Google Maps
        </a>

        <div class="social-icons">
          <!-- Email -->
          <a
            href="https://mail.google.com/mail/u/0/#inbox?compose=GTvVlcSHxjWGjBBnqjWbRNdvSSzmBCkVdHnGFpHBMQCWprGTbFqCQFrPDhMjZnVLVqZvcwhFLJRhN"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LBBC Paris"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 5h18v14H3V5zm2 2v.5l7 5 7-5V7l-7 5-7-5z"></path>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/profile.php?id=61553990219196"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M14 8h3V4h-3c-3.3 0-5 1.9-5 5v2H6v4h3v5h4v-5h3.5l.5-4H13V9c0-.7.3-1 1-1z"
              ></path>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
